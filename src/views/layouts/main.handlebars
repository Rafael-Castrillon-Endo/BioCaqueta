<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BioCaquetá — Registro de Avistamientos</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            brand: {
              50: '#f0fdf4', 100: '#dcfce7', 200: '#bbf7d0', 300: '#86efac',
              400: '#4ade80', 500: '#22c55e', 600: '#16a34a', 700: '#15803d',
              800: '#166534', 900: '#14532d'
            }
          }
        }
      }
    }
  </script>
  <style>
    body { background: radial-gradient(circle at top, #f8faf9 0%, #eef1ef 60%); }
    ::selection { background: #bbf7d0; }
  </style>
</head>
<body class="min-h-screen font-sans text-slate-800 antialiased">
  <header class="sticky top-0 z-10 border-b border-slate-200/70 bg-white/80 backdrop-blur">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
      <a href="/" class="flex items-center gap-2.5">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-600 text-base text-white">🌿</span>
        <div class="leading-tight">
          <p class="font-semibold tracking-tight text-slate-900">BioCaquetá</p>
          <p class="text-xs text-slate-500">Registro de biodiversidad</p>
        </div>
      </a>
      <nav class="text-sm text-slate-500">
        <a href="/" class="transition-colors hover:text-slate-900">Avistamientos</a>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-5xl px-6 py-10">
    {{{body}}}
  </main>

  <footer class="mx-auto max-w-5xl px-6 py-10 text-center text-xs text-slate-400">
    Taller Práctico Backend — Node.js, Express &amp; MongoDB
  </footer>
</body>
</html>
