<div class="mx-auto max-w-xl space-y-6">
  <div>
    <a href="/" class="text-xs font-medium text-slate-500 hover:text-slate-800">&larr; Volver al listado</a>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight text-slate-900">Editar avistamiento</h1>
    <p class="text-sm text-slate-500">
      {{avistamiento.nombreComun}}
      <span class="italic text-slate-400">({{avistamiento.nombreCientifico}})</span>
    </p>
  </div>

  <form action="/api/avistamientos/update/{{avistamiento._id}}" method="POST"
    class="space-y-5 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">

    <div class="grid grid-cols-1 gap-4 opacity-70 sm:grid-cols-2">
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-medium text-slate-600">Nombre común</label>
        <input type="text" value="{{avistamiento.nombreComun}}" disabled
          class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-500">
      </div>
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-medium text-slate-600">Categoría</label>
        <input type="text" value="{{avistamiento.categoria}}" disabled
          class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-500">
      </div>
    </div>

    <div class="flex flex-col gap-1.5">
      <label for="zona" class="text-xs font-medium text-slate-600">Zona</label>
      <input id="zona" name="zona" type="text" value="{{avistamiento.zona}}" required
        class="rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-100">
    </div>

    <div class="flex flex-col gap-1.5">
      <label for="estadoConservacion" class="text-xs font-medium text-slate-600">Estado de conservación</label>
      <select id="estadoConservacion" name="estadoConservacion"
        class="rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-100">
        <option value="Preocupación menor" {{#if (eq avistamiento.estadoConservacion "Preocupación menor")}}selected{{/if}}>Preocupación menor</option>
        <option value="Vulnerable" {{#if (eq avistamiento.estadoConservacion "Vulnerable")}}selected{{/if}}>Vulnerable</option>
        <option value="En peligro" {{#if (eq avistamiento.estadoConservacion "En peligro")}}selected{{/if}}>En peligro</option>
      </select>
    </div>

    <div class="flex items-center justify-end gap-3 pt-2">
      <a href="/" class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-50">
        Cancelar
      </a>
      <button type="submit"
        class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-brand-700">
        Guardar cambios
      </button>
    </div>
  </form>
</div>
